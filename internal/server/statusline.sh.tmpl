#!/bin/bash
set -euo pipefail

# ─── AGY Cost Board Configuration ───────────────────────────────────────────
DEFAULT_BOARD_URL="{{.DefaultBoardURL}}"
DEFAULT_USER="{{.DefaultUser}}"
DEFAULT_DAYS="{{.DefaultDays}}"
DEFAULT_TTL="{{.DefaultTTL}}"

BOARD_URL="${AGY_COST_BOARD_URL:-$DEFAULT_BOARD_URL}"
DAYS="${AGY_COST_DAYS:-$DEFAULT_DAYS}"
CACHE_TTL="${AGY_COST_CACHE_TTL:-$DEFAULT_TTL}"
DISABLED="${AGY_COST_DISABLED:-false}"

# ─── ANSI Helpers (Standard 16-color palette only) ───────────────────────────
R="\033[0m"         # Reset
B="\033[1m"         # Bold
D="\033[2m"         # Dim
I="\033[3m"         # Italic

# Foreground accents (Standard 16 colors)
FG_BLACK="\033[30m"
FG_RED="\033[31m"
FG_GREEN="\033[32m"
FG_YELLOW="\033[33m"
FG_BLUE="\033[34m"
FG_MAGENTA="\033[35m"
FG_CYAN="\033[36m"
FG_WHITE="\033[37m"

FG_GRAY="\033[90m"
FG_BRIGHT_RED="\033[91m"
FG_BRIGHT_GREEN="\033[92m"
FG_BRIGHT_YELLOW="\033[93m"
FG_BRIGHT_BLUE="\033[94m"
FG_BRIGHT_MAGENTA="\033[95m"
FG_BRIGHT_CYAN="\033[96m"
FG_BRIGHT_WHITE="\033[97m"

# Number Highlight Color
NUM_COLOR="${FG_BRIGHT_WHITE}${B}"

# ─── Parse JSON from stdin (Single jq pass for performance) ──────────────────
# Extract all fields in one pass to prevent spawning jq 8 times.
{
  read -r STATE
  read -r USED_PCT
  read -r VCS_BRANCH
  read -r VCS_DIRTY
  read -r SANDBOX
  read -r ARTIFACTS
  read -r SUBAGENTS
  read -r BG_TASKS
  read -r MODEL
  read -r COLS
} <<< "$(
  jq -r '
    (.agent_state // "idle"),
    (.context_window.used_percentage // 0),
    (.vcs.branch // ""),
    (.vcs.dirty // false),
    (.sandbox.enabled // false),
    (.artifact_count // 0),
    (if .subagents | type == "array" then (.subagents | length) else 0 end),
    (.task_count // 0),
    (.model.display_name // ""),
    (.terminal_width // 80)
  ' 2>/dev/null || printf "idle\n0\n\nfalse\nfalse\n0\n0\n0\n\n80\n"
)"

# ─── Computed Values ─────────────────────────────────────────────────────────
# Use LC_NUMERIC=C to prevent bash printf errors in locales that use commas for decimals
PCT_FMT=$(LC_NUMERIC=C printf "%.1f" "$USED_PCT")
PCT_INT=${USED_PCT%.*}; PCT_INT=${PCT_INT:-0}

# ─── State Indicator (No background colors) ──────────────────────────────────
case "$STATE" in
  idle)     S="${FG_BRIGHT_GREEN}${B}● READY${R}" ;;
  thinking) S="${FG_BRIGHT_YELLOW}${B}◆ THINKING${R}" ;;
  working)  S="${FG_BRIGHT_CYAN}${B}⚙ WORKING${R}" ;;
  tool_use) S="${FG_BRIGHT_MAGENTA}${B}🔧 TOOL${R}" ;;
  *)        S="${FG_WHITE}${B}⏳ $(echo "$STATE" | tr '[:lower:]' '[:upper:]')${R}" ;;
esac

# ─── VCS Branch ──────────────────────────────────────────────────────────────
V=""
if [ -n "$VCS_BRANCH" ]; then
  if [ "$VCS_DIRTY" = "true" ]; then
    V="${FG_GRAY} ╱ ${FG_BRIGHT_RED}${VCS_BRANCH}${FG_BRIGHT_YELLOW}*${R}"
  else
    V="${FG_GRAY} ╱ ${FG_BRIGHT_BLUE}${VCS_BRANCH}${R}"
  fi
fi

# ─── Model ───────────────────────────────────────────────────────────────────
M=""
if [ -n "$MODEL" ]; then
  M="${FG_GRAY} ╱ ${FG_BRIGHT_MAGENTA}${I}${MODEL}${R}"
fi

# ─── Sandbox Badge ───────────────────────────────────────────────────────────
if [ "$SANDBOX" = "true" ]; then
  SB="${FG_GRAY}sandbox ${FG_BRIGHT_GREEN}${B}ON${R}"
else
  SB="${FG_GRAY}sandbox off${R}"
fi

# ─── Context Bar (15 segments, fine-grain Unicode) ────────────────────────────
BAR_LEN=15
FILLED=$((PCT_INT * BAR_LEN / 100))
REMAINDER=$(( (PCT_INT * BAR_LEN) % 100 ))

# Pick color based on percentage
if [ "$PCT_INT" -ge 90 ]; then
  BAR_COLOR="$FG_BRIGHT_RED"
elif [ "$PCT_INT" -ge 60 ]; then
  BAR_COLOR="$FG_BRIGHT_YELLOW"
else
  BAR_COLOR="$FG_BRIGHT_WHITE"
fi

# Build bar with partial-fill last block
BAR=""
for ((i = 0; i < BAR_LEN; i++)); do
  if [ "$i" -lt "$FILLED" ]; then
    BAR="${BAR}█"
  elif [ "$i" -eq "$FILLED" ]; then
    if [ "$REMAINDER" -ge 75 ]; then
      BAR="${BAR}▓"
    elif [ "$REMAINDER" -ge 50 ]; then
      BAR="${BAR}▒"
    elif [ "$REMAINDER" -ge 25 ]; then
      BAR="${BAR}░"
    else
      BAR="${BAR}·"
    fi
  else
    BAR="${BAR}·"
  fi
done

# ─── Stats ───────────────────────────────────────────────────────────────────
CTX="${FG_GRAY}ctx ${BAR_COLOR}${BAR} ${NUM_COLOR}${PCT_FMT}%${R}"
ART_FMT="${FG_GRAY}artifacts ${NUM_COLOR}${ARTIFACTS}${R}"
SUB_FMT="${FG_GRAY}subagents ${NUM_COLOR}${SUBAGENTS}${R}"
BG_FMT="${FG_GRAY}tasks ${NUM_COLOR}${BG_TASKS}${R}"

# ─── Separators ──────────────────────────────────────────────────────────────
DOT="${FG_GRAY} · ${R}"

# ─── Spend & Cost Attribution ────────────────────────────────────────────────
COST_FMT=""

resolve_cost_user() {
  if [ -n "${AGY_COST_USER:-}" ]; then
    echo "$AGY_COST_USER"
    return
  fi
  if [ -n "${DEFAULT_USER:-}" ]; then
    echo "$DEFAULT_USER"
    return
  fi
  local gcloud_user
  gcloud_user="$(gcloud config get-value account 2>/dev/null || true)"
  if [ -n "$gcloud_user" ] && [ "$gcloud_user" != "(unset)" ]; then
    echo "$gcloud_user"
    return
  fi
  local git_user
  git_user="$(git config user.email 2>/dev/null || true)"
  if [ -n "$git_user" ]; then
    echo "$git_user"
    return
  fi
  echo "${USER:-}"
}

if [ "$DISABLED" != "true" ]; then
  COST_USER="$(resolve_cost_user)"
  if [ -n "$COST_USER" ]; then
    USER_HASH="$(printf "%s" "$COST_USER" | tr -c 'a-zA-Z0-9_' '_')"
    CACHE_FILE="/tmp/agy_cost_${USER_HASH}.cache"
    LOCK_FILE="/tmp/agy_cost_${USER_HASH}.lock"

    CURRENT_TIME=$(date +%s 2>/dev/null || echo 0)
    CACHE_EXPIRED=true
    CACHED_VALUE=""

    if [ -f "$CACHE_FILE" ]; then
      CACHE_MOD_TIME=$(stat -f "%m" "$CACHE_FILE" 2>/dev/null || stat -c "%Y" "$CACHE_FILE" 2>/dev/null || echo 0)
      AGE=$(( CURRENT_TIME - CACHE_MOD_TIME ))
      if [ "$AGE" -lt "$CACHE_TTL" ]; then
        CACHE_EXPIRED=false
      fi
      CACHED_VALUE="$(head -n 1 "$CACHE_FILE" 2>/dev/null || true)"
    fi

    # Trigger background async refresh if cache is missing or expired
    if [ "$CACHE_EXPIRED" = "true" ]; then
      LOCK_STALE=true
      if [ -f "$LOCK_FILE" ]; then
        LOCK_TIME=$(stat -f "%m" "$LOCK_FILE" 2>/dev/null || stat -c "%Y" "$LOCK_FILE" 2>/dev/null || echo 0)
        LOCK_AGE=$(( CURRENT_TIME - LOCK_TIME ))
        if [ "$LOCK_AGE" -lt 15 ]; then
          LOCK_STALE=false
        fi
      fi

      if [ "$LOCK_STALE" = "true" ]; then
        touch "$LOCK_FILE" 2>/dev/null || true
        (
          ID_TOKEN="$(gcloud auth print-identity-token 2>/dev/null || true)"
          CLEAN_BOARD_URL="${BOARD_URL%/}"
          API_URL="${CLEAN_BOARD_URL}/api/v1/users/${COST_USER}?days=${DAYS}"

          if [ -n "$ID_TOKEN" ]; then
            RESP="$(curl -sS --max-time 3 -H "Authorization: Bearer $ID_TOKEN" "$API_URL" 2>/dev/null || true)"
          else
            RESP="$(curl -sS --max-time 3 "$API_URL" 2>/dev/null || true)"
          fi

          if [ -n "$RESP" ]; then
            TOTAL_COST="$(printf "%s" "$RESP" | jq -r 'if .total_cost == null then "--" else (.total_cost | round | tostring) end' 2>/dev/null || true)"
            if [ -n "$TOTAL_COST" ] && [ "$TOTAL_COST" != "null" ]; then
              printf "%s\n" "$TOTAL_COST" > "${CACHE_FILE}.tmp" 2>/dev/null && mv -f "${CACHE_FILE}.tmp" "$CACHE_FILE" 2>/dev/null || true
            fi
          fi
          rm -f "$LOCK_FILE" 2>/dev/null || true
        ) >/dev/null 2>&1 &
      fi
    fi

    if [ -n "$CACHED_VALUE" ]; then
      COST_FMT="${DOT}${FG_GRAY}cost ${NUM_COLOR}\$${CACHED_VALUE}${R}"
    fi
  fi
fi

# ─── Output ──────────────────────────────────────────────────────────────────
LINE1="${S}${M}${V}"
LINE2=" ${CTX}${DOT}${ART_FMT}${DOT}${SUB_FMT}${DOT}${BG_FMT}${DOT}${SB}${COST_FMT}"

if [ "$COLS" -ge 120 ]; then
  # Wide: single line
  echo -e "${LINE1}${FG_GRAY}  │  ${R}${LINE2}"
elif [ "$COLS" -ge 80 ]; then
  # Medium: two-line layout with border
  echo -e "${FG_GRAY}╭─${R} ${LINE1}"
  echo -e "${FG_GRAY}╰─${R}${LINE2}"
else
  # Narrow: compact two-line, minimal chrome
  echo -e "${S}${M}"
  echo -e "${CTX}${DOT}${BG_FMT}${COST_FMT}"
fi
